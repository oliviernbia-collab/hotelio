############################################################################
#  Hôtelio — configuration de production pour un hébergement mutualisé LWS
#
#  Sur le serveur : copier ce fichier en ~/hotelio/.env, remplir les valeurs
#  marquées A_REMPLIR, puis lancer `php artisan key:generate`.
#  Pas de Redis ni de worker chez LWS : cache, sessions et file = database/sync.
############################################################################

APP_NAME="Hôtelio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://A_REMPLIR.com
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de données (cPanel → Bases de données MySQL) ─────────
# Chez LWS, base et utilisateur sont préfixés par l'identifiant cPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=A_REMPLIR_hotelio
DB_USERNAME=A_REMPLIR_hotelio
DB_PASSWORD=A_REMPLIR

# ── Sessions / cache / file (pas de Redis sur mutualisé) ──────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# Aucun job mis en file dans le code : exécution immédiate, pas de worker requis.
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── CORS / Sanctum (application mobile) ───────────────────────
# Origines autorisées séparées par des virgules (par défaut : APP_URL).
# CORS_ALLOWED_ORIGINS=https://A_REMPLIR.com
# SANCTUM_STATEFUL_DOMAINS=A_REMPLIR.com,www.A_REMPLIR.com

# ── Cloudinary (reprendre les valeurs du .env local) ──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_URL=

# ── Jèko — clés de PRODUCTION (business.jeko.africa) ──────────
# Webhook à déclarer chez Jèko : https://A_REMPLIR.com/api/webhooks/jeko
JEKO_STORE_ID=
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_WEBHOOK_SECRET=
# Même valeur que dans backendMobile/.env
JEKO_INTERNAL_SYNC_KEY=

# ── Email (boîte créée dans cPanel → Comptes de messagerie) ───
MAIL_MAILER=smtp
MAIL_HOST=mail.A_REMPLIR.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=contact@A_REMPLIR.com
MAIL_PASSWORD=A_REMPLIR
MAIL_FROM_ADDRESS="contact@A_REMPLIR.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── SMS (log | orange | africastalking) ───────────────────────
SMS_DRIVER=log
ORANGE_API_TOKEN=
ORANGE_SENDER_ID=HotelioCI
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=HotelioCI

VITE_APP_NAME="${APP_NAME}"
