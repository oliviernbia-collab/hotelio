APP_NAME="Hôtelio"
APP_ENV=production
APP_KEY=                          # php artisan key:generate
APP_DEBUG=false
APP_URL=https://votre-domaine.com
APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de données ────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db                        # nom du service Docker
DB_PORT=3306
DB_DATABASE=hotelio
DB_USERNAME=hotelio
DB_PASSWORD=CHANGER_MOI
DB_ROOT_PASSWORD=CHANGER_MOI_AUSSI

# ── Cache & Sessions ───────────────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# ── File de travaux ────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis                  # nom du service Docker
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.votre-provider.com
MAIL_PORT=587
MAIL_USERNAME=contact@votre-domaine.com
MAIL_PASSWORD=CHANGER_MOI
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contact@votre-domaine.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Fichiers / Storage ─────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# Pour AWS S3 :
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_BUCKET=

# ── SMS (Côte d'Ivoire) ────────────────────────────────────────────────────────
SMS_DRIVER=log                    # log | orange | africastalking
ORANGE_SMS_TOKEN=
ORANGE_SMS_SENDER_ID=HotelioCI
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER=

# ── 2FA / Sécurité ────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── DomPDF (PDF Factures) ─────────────────────────────────────────────────────
DOMPDF_ENABLE_PHP=false
DOMPDF_ENABLE_REMOTE=false

# ── Désactiver les features de dev ────────────────────────────────────────────
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
NIGHTWATCH_ENABLED=false
